HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000
NODE_ENV=development
DATABASE_PATH=./data/bilin.sqlite
# 生产环境使用 HTTPS，并关闭网页初始化入口，改用管理员创建命令。
ALLOW_LOCAL_SETUP=true
# 公众号（微信内浏览器）与开放平台网站应用（PC 扫码）分别填写。
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_CALLBACK_URL=
